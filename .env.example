# --- Required ---
GROQ_API_KEY=your_groq_api_key_here
SERPER_API_KEY=your_serper_api_key_here

GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b

# Optional. Comma-separated fallback chain, tried in order when a model is
# rate-limited, decommissioned, or failing. Groq meters limits per model, so
# falling through also unlocks a fresh token budget.
# Default: openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b
GROQ_MODEL_CHAIN=

MAX_SEARCHES_PER_DAY=50
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Required on Vercel / any serverless host ---
# Serverless has no writable disk and no shared state between invocations,
# so search sessions must live in Redis. Locally these can be omitted and
# sessions fall back to ./.sessions on disk.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
