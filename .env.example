# --- Required (at least one LLM provider) ---
# Multiple keys supported (comma-separated). When one key hits its rate limit,
# the system automatically rotates to the next key.

# Primary LLM provider
GROQ_API_KEY=your_groq_api_key_here

# Optional fallback providers (free tiers available)
# Get OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get Cerebras key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Example with multiple keys per provider:
# GROQ_API_KEY=key1,key2,key3
# OPENROUTER_API_KEY=your_openrouter_key

# --- Search API ---
# Multiple keys supported (comma-separated).
SERPER_API_KEY=your_serper_api_key_here
# Example: SERPER_API_KEY=key1,key2

GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b

# Optional. Comma-separated fallback chain, tried in order when a model is
# rate-limited, decommissioned, or failing. Groq meters limits per model, so
# falling through also unlocks a fresh token budget.
# Default: automatic (all configured providers' models)
GROQ_MODEL_CHAIN=

MAX_SEARCHES_PER_DAY=50
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Required on Vercel / any serverless host ---
# Serverless has no writable disk and no shared state between invocations,
# so search sessions must live in Redis. Locally these can be omitted and
# sessions fall back to ./.sessions on disk.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
